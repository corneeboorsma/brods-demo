rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Templates: publiek lezen als gepubliceerd, schrijven alleen ingelogd
    match /templates/{templateId} {
      allow read: if resource.data.status == 'gepubliceerd'
                  || request.auth != null;
      allow create, update, delete: if request.auth != null;
    }

    // Publicaties: publiek lezen, schrijven alleen ingelogd
    match /publicaties/{pubId} {
      allow read: if true;
      allow create, delete: if request.auth != null;
    }

    // Bestellingen: iedereen mag aanmaken (bestelpagina) mits verplichte velden aanwezig zijn
    match /bestellingen/{bestId} {
      allow create: if request.resource.data.keys().hasAll(['voornaam', 'achternaam', 'email', 'tijdslot', 'regels', 'totaal'])
                    && request.resource.data.email is string
                    && request.resource.data.email.size() > 0
                    && request.resource.data.email.size() < 200
                    && request.resource.data.voornaam is string
                    && request.resource.data.voornaam.size() > 0
                    && request.resource.data.voornaam.size() < 100
                    && request.resource.data.achternaam is string
                    && request.resource.data.achternaam.size() > 0
                    && request.resource.data.achternaam.size() < 100;
      allow read, update, delete: if request.auth != null;

      // Mail history subcollectie: alleen Cloud Functions schrijven, ingelogd lezen
      match /mail_history/{histId} {
        allow read: if request.auth != null;
        allow write: if false; // Alleen via Cloud Functions (Admin SDK)
      }
    }

    // Themas: publiek lezen, schrijven alleen ingelogd
    match /themas/{themaId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // Audit log: alleen ingelogd lezen, schrijven alleen via Admin SDK (Cloud Functions)
    match /audit_log/{logId} {
      allow read: if request.auth != null;
      allow write: if false; // Alleen via Admin SDK
    }

    // Config (webhook tokens etc.): alleen Cloud Functions schrijven, ingelogd lezen
    match /_config/{configId} {
      allow read: if request.auth != null;
      allow write: if false; // Alleen via Admin SDK
    }
  }
}
